# ── Beelieve platform configuration ──────────────────────────────────
# Copy to .env and fill in real values. Every service reads only env vars.

# MQTT (Mosquitto)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=beelieve
MQTT_PASSWORD=CHANGE_ME

# Kafka (KRaft, single node in dev)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# TimescaleDB
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=beelieve
POSTGRES_USER=beelieve
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://beelieve:CHANGE_ME@timescaledb:5432/beelieve

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_MIN=1440
CORS_ORIGINS=http://localhost:3030

# ML inference
MODEL_DIR=/models
MODEL_VERSION=lgbm-2026.08

# Mistral-7B recommender (Hugging Face)
HF_API_KEY=HF_API_KEY
HF_MODEL_ID=aidxhxr/beelieve-mistral-7b-advisor
HF_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
RECOMMENDER_PORT=8100
RECOMMENDER_LANG_DEFAULT=en

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Hive simulator (dev only)
SIM_NUM_HIVES=12
SIM_INTERVAL_SECONDS=10
